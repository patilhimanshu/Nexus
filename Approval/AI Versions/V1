    ],
}

def similarity(a, b):
    return SequenceMatcher(None, a, b).ratio()

def detect_intent(q):
    """
    Loose matching: for every intent, check every trigger phrase.
    A phrase 'wins' if it's a substring OR similar enough (fuzzy ratio)
    to some sliding window of the query. This is still NOT a real LLM
    classifier — it's a step up from exact keywords, not full NLU.

    NOTE: short trigger words (like "yo") use word-boundary matching
    instead of raw substring matching, otherwise they false-positive
    inside unrelated words ("yo" inside "how are YOu").
    """
    q = q.lower().strip()
    words = set(q.split())
    best_intent = None
    best_score = 0.0

    for intent, phrases in INTENT_PHRASES.items():
        for phrase in phrases:
            if len(phrase) <= 3:
                # short phrase -> must match a whole word, not a substring
                if phrase in words:
                    return intent
            elif phrase in q:
                # longer phrase -> substring match is safe enough
                return intent
            score = similarity(phrase, q)
            if score > best_score:
                best_score = score
                best_intent = intent

    if best_score >= FUZZY_THRESHOLD:
        return best_intent

    return "UNKNOWN"

# ======================================================
# ================= SEARCH HANDLER =======================
# ======================================================

def clean_query(query, strip_words):
    clean = query
    for w in strip_words:
        clean = clean.replace(w, "")
    return clean.strip()

def handle_search(query):
    clean = clean_query(query, ["search for", "find me", "look up", "search",
                                  "on youtube", "on google", "youtube", "yt"])
    if not clean:
        speak("What should I search for?")
        return

    if "youtube" in query or "yt" in query:
        speak(f"Searching YouTube for {clean}")
        url = f"https://www.youtube.com/results?search_query={clean.replace(' ', '+')}"
    else:
        speak(f"Searching Google for {clean}")
        url = f"https://www.google.com/search?q={clean.replace(' ', '+')}"

    webbrowser.open(url)
    context["last_intent"] = "SEARCH"
    context["last_query"] = clean

def handle_wiki(query):
    clean = clean_query(query, ["what is", "who is", "tell me about", "explain"])
    if not clean:
        speak("Who or what should I look up?")
        return

    try:
        summary = wikipedia.summary(clean, sentences=2)
        speak(summary)
    except wikipedia.exceptions.DisambiguationError as e:
        speak(f"That's a bit ambiguous. Did you mean: {', '.join(e.options[:3])}?")
    except wikipedia.exceptions.PageError:
        speak(f"I couldn't find anything on Wikipedia for {clean}.")
    except Exception:
        speak("Something went wrong looking that up.")

    context["last_intent"] = "WIKI_SEARCH"
    context["last_query"] = clean

# ======================================================
# ============== FILE SEARCH + APP LAUNCH ================
# ======================================================

def find_file(query):
    target = clean_query(query, ["find file", "find folder", "locate file",
                                   "search my pc for"])
    if not target:
        speak("What file or folder should I look for?")
        return

    speak(f"Searching for {target}, this might take a moment.")
    matches = []
    for root, dirs, files in os.walk(SEARCH_ROOT):
        # skip noisy system/hidden dirs to keep this fast
        dirs[:] = [d for d in dirs if not d.startswith(".")]
        for name in files + dirs:
            if target.lower() in name.lower():
                matches.append(os.path.join(root, name))
        if len(matches) >= 5:
            break

    if not matches:
        speak(f"No matches found for {target}.")
        return

    speak(f"Found {len(matches)} match(es):")
    for m in matches[:5]:
        print("  -", m)

def open_app(query):
    app_name = clean_query(query, ["open app", "launch", "start program", "run program"])
    if not app_name:
        speak("Which app should I open?")
        return

    speak(f"Trying to open {app_name}")
    try:
        # Works for common Windows apps registered on PATH (notepad, calc, etc.)
        # and most installed programs findable by name.
        os.startfile(app_name)
    except Exception:
        try:
            subprocess.Popen(app_name, shell=True)
        except Exception:
            speak(f"I couldn't find or launch {app_name}.")

# ======================================================
# ================= SYSTEM REPORT =========================
# ======================================================

def system_report():
    cpu = psutil.cpu_percent()
    ram = psutil.virtual_memory().percent
    disk = psutil.disk_usage("/").percent

    print("\n------------------------------------------")
    print("| Component | Usage |")
    print("------------------------------------------")
    print(f"| CPU       | {cpu}% |")
    print(f"| RAM       | {ram}% |")
    print(f"| Disk      | {disk}% |")
    print("------------------------------------------\n")

    speak(f"CPU {cpu} percent, RAM {ram} percent")

