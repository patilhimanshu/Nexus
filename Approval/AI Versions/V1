hour = dt.datetime.now().hour
if hour < 12:
    speak(f"Good morning {MASTER}")
elif hour < 18:
    speak(f"Good afternoon {MASTER}")
else:
    speak(f"Good evening {MASTER}")

speak("Charlie is online. What's up?")

# ======================================================
# ================= MAIN LOOP ==========================
# ======================================================

while True:
    query = input("You: ").lower().strip()
    if not query:
        continue

    intent = detect_intent(query)

    if intent == "SEARCH":
        handle_search(query)

    elif intent == "WIKI_SEARCH":
        handle_wiki(query)

    elif intent == "PLAY_MUSIC":
        speak("Playing music")
        if os.path.exists(MUSIC_DIR):
            songs = os.listdir(MUSIC_DIR)
            if songs:
                os.startfile(os.path.join(MUSIC_DIR, songs[0]))
            else:
                speak("No songs found in your music folder.")
        else:
            speak("I couldn't find your music folder.")

    elif intent == "OPEN_EDITOR":
        speak("Opening editor")
        os.system("notepad")

    elif intent == "OPEN_CMD":
        speak("Opening command prompt")
        os.system("start cmd")

    elif intent == "OPEN_YOUTUBE":
        speak("Opening YouTube")
        webbrowser.open("https://youtube.com")

    elif intent == "OPEN_GOOGLE":
        speak("Opening Google")
        webbrowser.open("https://google.com")

    elif intent == "FIND_FILE":
        find_file(query)

    elif intent == "OPEN_APP":
        open_app(query)

    elif intent == "TIME":
        speak("It's " + dt.datetime.now().strftime("%I:%M %p"))

    elif intent == "SYSTEM_REPORT":
        speak("Here's the system report")
        system_report()

    elif intent == "AGAIN" and context["last_intent"] in ("SEARCH", "WIKI_SEARCH"):
        speak(f"Repeating: {context['last_query']}")
        if context["last_intent"] == "SEARCH":
            webbrowser.open(f"https://www.google.com/search?q={context['last_query'].replace(' ', '+')}")
        else:
            handle_wiki(f"what is {context['last_query']}")

    elif intent in SMALL_TALK_RESPONSES:
        speak(random.choice(SMALL_TALK_RESPONSES[intent]))

    elif intent == "EXIT":
        speak("Alright, see you later")
        break

    else:
        speak(random.choice([
            "Hmm, not sure what you mean.",
            "Okay, what next?",
            "I'm listening.",
            "Could you say that differently?"
        ]))
