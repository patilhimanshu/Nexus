MASTER = "Aahil"
SEARCH_ROOT = os.path.expanduser("~")        # where file search starts
MUSIC_DIR = os.path.join(os.path.expanduser("~"), "Music")
FUZZY_THRESHOLD = 0.72                        # 0-1, higher = stricter matching

# ======================================================
# ================= VOICE SETUP =========================
# ======================================================

voice_enabled = input("Enable voice? (Y/N): ").strip().lower() == "y"

def speak(text):
    print("Charlie:", text)
    if voice_enabled:
        engine = pyttsx3.init("sapi5")
        engine.setProperty("voice", engine.getProperty("voices")[0].id)
        engine.say(text)
        engine.runAndWait()
        engine.stop()

