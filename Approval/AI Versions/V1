# ======================================================
# ============== FUZZY INTENT MATCHING ==================
# ======================================================
# Old Charlie: exact keyword match (`"music" in q`) — breaks on
# "play me a song please" if phrasing drifts even slightly.
# New Charlie: each intent has trigger PHRASES, not just words,
# and we score the closest match instead of requiring an exact hit.

INTENT_PHRASES = {
    "SEARCH":        ["search for", "find me", "look up", "search"],
    "PLAY_MUSIC":     ["play music", "play a song", "play song"],
    "OPEN_EDITOR":    ["open notepad", "open editor", "open text editor"],
    "OPEN_CMD":       ["open cmd", "open terminal", "open command prompt"],
    "OPEN_YOUTUBE":   ["open youtube", "go to youtube"],
    "OPEN_GOOGLE":    ["open google", "go to google"],
    "WIKI_SEARCH":    ["what is", "who is", "tell me about", "explain"],
    "TIME":           ["what time is it", "tell me the time", "current time"],
    "SYSTEM_REPORT":  ["system report", "system status", "how is my pc doing"],
    "FIND_FILE":      ["find file", "find folder", "locate file", "search my pc for"],
    "OPEN_APP":       ["open app", "launch", "start program", "run program"],
    "AGAIN":          ["do it again", "again", "repeat that"],
    "EXIT":           ["exit", "quit", "bye", "goodbye", "shut down"],

    # ---- small talk: this is what makes it feel human, not a CLI ----
    "GREETING_CASUAL": ["whats up", "what's up", "wassup", "sup", "hows it going",
                         "how's it going", "yo"],
    "HOW_ARE_YOU":      ["how are you", "how you doing", "you good", "you alright"],
    "WHO_ARE_YOU":      ["who are you", "what are you", "what can you do"],
    "THANKS":           ["thank you", "thanks", "appreciate it"],
    "BORED":            ["im bored", "i'm bored", "bored"],
}

# Small talk gets MULTIPLE possible replies so it doesn't feel like a
# scripted bot saying the exact same line every single time.
